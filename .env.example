# Environment for the Indic Sign landing page.
#
#   cp .env.example .env
#
# There is very little here, and that is not an oversight. The page is a static build
# served by nginx — no API, no database, no keys.


# The URL every CTA on the page opens — the hero button, the header button, and the
# one above the footer. Read by APP_URL in src/content.ts.
#
# The VITE_ prefix is not decoration: Vite only exposes a variable to the page when it
# carries that prefix. Vite also inlines it into the bundle at BUILD time, so it has
# to be set before `npm run build` runs:
#
#   local          .env, or VITE_SUBPAGE=... npm run build
#   docker         --build-arg VITE_SUBPAGE=...
#   Railway/CI     a build variable, not a runtime one — a runtime value arrives too
#                  late and the page will quietly ship the fallback instead
#
# There is no fallback in the source, on purpose — the URL is not kept in this
# repository. Unset, the build fails with a message telling you this; it does not
# quietly ship three buttons that go nowhere.
#
# Fill this in locally in .env, which is gitignored. Never here.
VITE_SUBPAGE=


# The port nginx listens on. The nginx image's envsubst entrypoint fills it into
# nginx.conf at container start, which is why the port is not hardcoded there.
# Railway assigns this and overrides the Dockerfile's default; set it yourself only
# when running the image locally on a busy port:
#
#   docker run -e PORT=8080 -p 8080:8080 indicai-landing
#
# `npm run dev` ignores this — Vite serves on 5173.
PORT=80


# ---------------------------------------------------------------------------
# Deliberately not here
#
# DOCKER_USERNAME and DOCKER_PASSWORD push the image in .github/workflows/ci.yml.
# They are GitHub Actions secrets on the `production` environment, not variables in
# this file. Credentials do not belong in a .env.
